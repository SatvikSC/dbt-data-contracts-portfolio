# Copy to .env and fill in values — never commit .env

# ── Databricks SQL Warehouse (prod target) ────────────────────────────────────
# Create a SQL Warehouse in Databricks: Compute → SQL Warehouses → Create
# Then: Connection details → copy Server hostname and HTTP path
DBT_DATABRICKS_HOST=your-workspace.azuredatabricks.net
DBT_DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your-warehouse-id
DBT_DATABRICKS_TOKEN=dapiXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── GitHub Actions secrets (set once in repo Settings → Secrets) ──────────────
# DBT_DATABRICKS_HOST       → same value as above
# DBT_DATABRICKS_HTTP_PATH  → same value as above
# DBT_DATABRICKS_TOKEN      → same value as above

# ── dbt prod target schema ────────────────────────────────────────────────────
# Catalog and output schema for the prod run (workspace.dbt_prod)
DBT_TARGET_CATALOG=workspace
DBT_TARGET_SCHEMA=dbt_prod

# ── dbt source catalog (prod only) ───────────────────────────────────────────
# Passed via --vars '{"source_database": "workspace"}' in prod dbt commands.
# Leave empty for DuckDB dev (no catalog qualifier needed).
# DBT_SOURCE_CATALOG=workspace

# ── Local DuckDB dev ──────────────────────────────────────────────────────────
# Path to your local DuckDB file.  Populate it with: python scripts/setup_ci_db.py
DBT_DUCKDB_PATH=C:/venvs/portfolio_db/dev.duckdb
